<!DOCTYPE html>
<html>
<head>
  <title>Multi-App Deployer Script Generator</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main>
    <h1>Multi-App Deployer Script Generator</h1>

    <form action="./generate-script" method="post">
      <div id="apps-container">
        <!-- App configs will be added here -->
      </div>
      <button type="button" id="add-app">Add App</button>
      <br><br>
      <input type="submit" value="Generate All-in-One Script">
    </form>
  </main>

  <template id="app-template">
    <div class="app-config">
      <hr>
      <label>GitHub Repository URL:</label><br>
      <input type="text" name="github_url" size="50" required><br><br>
      <label>Server Path:</label><br>
      <input type="text" name="path" size="50" required><br><br>
      <label>User:</label><br>
      <input type="text" name="user" size="50" required><br><br>
      <label>Webhook Secret:</label><br>
      <input type="password" name="secret" size="50" required><br><br>
      <button type="button" class="remove-app">Remove App</button>
    </div>
  </template>

  <script src="/main.js" defer></script>
</body>
</html>
