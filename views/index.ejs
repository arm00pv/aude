<!DOCTYPE html>
<html>
<head>
  <title>Auto Deployer Script Generator</title>
</head>
<body>
  <h1>Auto Deployer Script Generator</h1>

  <form action="/generate-script" method="post">
    <label for="github_url">GitHub Repository URL:</label><br>
    <input type="text" id="github_url" name="github_url" size="50" required><br><br>
    <label for="path">Server Path:</label><br>
    <input type="text" id="path" name="path" size="50" required><br><br>
    <label for="user">User:</label><br>
    <input type="text" id="user" name="user" size="50" required><br><br>
    <label for="port">Port:</label><br>
    <input type="number" id="port" name="port" value="3001" required><br><br>
    <input type="submit" value="Generate Script">
  </form>
</body>
</html>
